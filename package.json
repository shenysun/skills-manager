{
  "name": "skills-manager-cli",
  "version": "2026.9.18",
  "packageManager": "pnpm@10.33.0",
  "description": "CLI-first agent skill hub: one npx bootstrap, then manage skills in agent conversation — install from git/URL/archive/marketplace/well-known sources, distribute symlink-or-copy to 70+ agents, tree-SHA update anchors, provenance backfill, optional local dashboard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shenysun/skills-manager.git"
  },
  "homepage": "https://github.com/shenysun/skills-manager#readme",
  "bugs": {
    "url": "https://github.com/shenysun/skills-manager/issues"
  },
  "scripts": {
    "skills-manager": "tsx src/cli.ts",
    "build": "pnpm run clean && tsc -p tsconfig.json && node scripts/copy-catalog-snapshot.mjs && vite build --config dashboard-web/vite.config.ts",
    "build:cli": "pnpm run clean && tsc -p tsconfig.json && node scripts/copy-catalog-snapshot.mjs",
    "build:web": "vite build --config dashboard-web/vite.config.ts",
    "dev:web": "vite --config dashboard-web/vite.config.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "catalog:extract": "tsx scripts/extract-agent-catalog.ts",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "skills",
    "skills-manager",
    "agent",
    "agents",
    "agent-skills",
    "skill-hub",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "opencode",
    "cli",
    "dashboard",
    "distribute",
    "provenance",
    "marketplace",
    "SKILL.md"
  ],
  "author": "shenysun <shenysun@163.com>",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "commander": "^15.0.0",
    "fastify": "^5.11.2",
    "isomorphic-dompurify": "^3.23.0",
    "markdown-it": "^15.0.0",
    "shiki": "^4.4.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.1.2",
    "@unocss/reset": "^66.10.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "reka-ui": "^2.10.4",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2",
    "unocss": "^66.10.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "private": false,
  "bin": {
    "skills-manager": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "docs/CLI.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
