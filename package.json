{
  "name": "@shenysun/skills-manager",
  "version": "0.1.0",
  "description": "Local-first CLI and dashboard for managing agent, Claude, and Codex skills",
  "scripts": {
    "skills-manager": "tsx src/cli.ts",
    "build": "npm run clean && tsc -p tsconfig.json && vite build --config dashboard-web/vite.config.ts",
    "build:cli": "npm run clean && tsc -p tsconfig.json",
    "build:web": "vite build --config dashboard-web/vite.config.ts",
    "dev:web": "vite --config dashboard-web/vite.config.ts",
    "doctor": "tsx src/cli.ts doctor",
    "dashboard": "tsx src/cli.ts dashboard",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "smoke:core": "npm run build:cli && node scripts/smoke-core-services.mjs",
    "smoke:cli": "npm run build:cli && node scripts/smoke-cli-resolution.mjs",
    "smoke:api": "npm run build:cli && node scripts/smoke-dashboard-api.mjs",
    "smoke:package": "npm run build && node scripts/smoke-package.mjs",
    "test:dashboard-hash": "tsx --test dashboard-web/src/routing/resolveDashboardHash.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@vicons/ionicons5": "^0.13.0",
    "commander": "^15.0.0",
    "fastify": "^5.11.2",
    "naive-ui": "^2.44.1",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "private": false,
  "bin": {
    "skills-manager": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs/CLI.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
